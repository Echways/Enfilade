@namespace Enfilade
@typeparam TValue
@using System.ComponentModel.DataAnnotations
@using System.Linq.Expressions
@using System.Reflection
@using Microsoft.AspNetCore.Components.Forms
@inject ViewerTime Viewer

@switch (_kind)
{
    case FieldKind.Text:
        <MudTextField T="TValue" Value="Current" ValueChanged="SetAsync" For="For" Label="@Title" HelperText="@HintText" Required="_required"
                      Disabled="Disabled" Lines="Lines" InputType="@(Secret ? InputType.Password : InputType.Text)" />
        break;
    case FieldKind.Number:
        <MudNumericField T="TValue" Value="Current" ValueChanged="SetAsync" For="For" Label="@Title" HelperText="@HintText" Required="_required"
                         Disabled="Disabled" />
        break;
    case FieldKind.Switch:
        <MudSwitch T="TValue" Value="Current" ValueChanged="SetAsync" For="For" Label="@Title" Disabled="Disabled" Color="Color.Primary" />
        break;
    case FieldKind.Check:
        <MudCheckBox T="TValue" Value="Current" ValueChanged="SetAsync" For="For" Label="@Title" Disabled="Disabled" TriState="true" />
        break;
    case FieldKind.Select:
        <MudSelect T="TValue" Value="Current" ValueChanged="SetAsync" For="For" Label="@Title" HelperText="@HintText" Required="_required"
                   Disabled="Disabled" ToStringFunc="TitleOf" Clearable="@(default(TValue) is null)">
            @foreach (var option in _choices)
            {
                <MudSelectItem T="TValue" Value="option.Value">@option.Title</MudSelectItem>
            }
        </MudSelect>
        break;
    case FieldKind.Date:
        <MudDatePicker Date="Day" DateChanged="DayChanged" Label="@Title" HelperText="@HintText" Required="_required" Disabled="Disabled"
                       DateFormat="yyyy-MM-dd" Editable="true" />
        <ValidationMessage For="For" />
        break;
    case FieldKind.Moment:
        <div class="pair">
            <MudDatePicker Date="Wall?.Date" DateChanged="WallDayChanged" Label="@Title" HelperText="@HintText" Required="_required"
                           Disabled="Disabled" DateFormat="yyyy-MM-dd" Editable="true" />
            <MudTimePicker Time="Wall?.TimeOfDay" TimeChanged="WallTimeChanged" Label="@Words.Format(EnfiladeText.TimeOf, Title)" Required="_required"
                           Disabled="Disabled" TimeFormat="HH:mm" AmPm="false" Editable="true" />
        </div>
        <ValidationMessage For="For" />
        break;
}

@code {
    private Func<TValue> _read = default!;
    private Action<TValue> _write = default!;
    private FieldIdentifier _field;
    private MemberInfo _member = default!;
    private FieldKind _kind;
    private bool _required;
    private string _label = "";
    private string? _hint;
    private IReadOnlyList<Option<TValue>>? _members;
    private IReadOnlyList<Option<TValue>> _choices = [];

    [CascadingParameter]
    private EditContext? Edit { get; set; }

    [Parameter, EditorRequired]
    public Expression<Func<TValue>> For { get; set; } = default!;

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? Hint { get; set; }

    [Parameter]
    public IReadOnlyList<Option<TValue>>? Options { get; set; }

    [Parameter]
    public int Lines { get; set; } = 1;

    [Parameter]
    public bool Secret { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private TValue Current => _read();

    private string Title => Label ?? _label;

    private string? HintText => Hint ?? _hint;

    private static Type Plain => Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);

    private DateTime? Day => Current is DateOnly day ? day.ToDateTime(TimeOnly.MinValue) : null;

    private DateTime? Wall => Current switch
    {
        DateTimeOffset moment => Viewer.ToViewer(moment),
        DateTime moment => Viewer.ToViewer(new DateTimeOffset(DateTime.SpecifyKind(moment, DateTimeKind.Utc))),
        _ => null,
    };

    protected override void OnParametersSet()
    {
        _kind = FieldKinds.Of(typeof(TValue), Options is not null);
        _choices = Options ?? (_members ??= Members());
        var field = FieldIdentifier.Create(For);
        if (field.Equals(_field))
            return;

        _field = field;
        _member = ((MemberExpression)For.Body).Member;
        var owner = field.Model;
        (Func<TValue> Read, Action<TValue> Write) access = _member switch
        {
            PropertyInfo property => (() => (TValue)property.GetValue(owner)!, value => property.SetValue(owner, value)),
            FieldInfo member => (() => (TValue)member.GetValue(owner)!, value => member.SetValue(owner, value)),
            _ => throw new NotSupportedException($"Enfilade: Field edits properties and fields, not {_member.Name}"),
        };
        (_read, _write) = access;
        _required = _member.GetCustomAttribute<RequiredAttribute>() is not null;
        _label = FieldLabel.Of(_member);
        _hint = FieldLabel.HintOf(_member);
    }

    private static IReadOnlyList<Option<TValue>> Members() => Plain.IsEnum
        ? [.. Enum.GetValues(Plain).Cast<Enum>().Select(value => new Option<TValue>((TValue)(object)value, Words.Named(value)))]
        : [];

    private Task SetAsync(TValue value)
    {
        _write(value);
        Edit?.NotifyFieldChanged(_field);
        return Task.CompletedTask;
    }

    private string TitleOf(TValue value) => _choices.FirstOrDefault(option => EqualityComparer<TValue>.Default.Equals(option.Value, value))?.Title ?? "";

    private Task DayChanged(DateTime? day) => day is { } chosen
        ? SetAsync((TValue)(object)DateOnly.FromDateTime(chosen))
        : default(TValue) is null ? SetAsync(default!) : Task.CompletedTask;

    private Task WallDayChanged(DateTime? day) => day is { } chosen
        ? SetWallAsync(chosen.Date + (Wall?.TimeOfDay ?? TimeSpan.Zero))
        : default(TValue) is null ? SetAsync(default!) : Task.CompletedTask;

    private Task WallTimeChanged(TimeSpan? time) => Wall is { } wall && time is { } chosen
        ? SetWallAsync(wall.Date + chosen)
        : Task.CompletedTask;

    private Task SetWallAsync(DateTime wall)
    {
        var moment = Viewer.FromViewer(wall);
        return SetAsync((TValue)(Plain == typeof(DateTimeOffset) ? moment : (object)moment.UtcDateTime));
    }
}
