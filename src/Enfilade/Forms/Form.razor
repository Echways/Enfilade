@namespace Enfilade
@implements IDisposable
@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Logging
@inject ISnackbar Snackbar
@inject CurrentPage CurrentPage
@inject IDialogService Dialogs
@inject ErrorMessages Errors
@inject ILogger<Form> Logger

<EditForm EditContext="_edit" OnValidSubmit="SubmitAsync" class="form">
    <DataAnnotationsValidator />
    <div class="group">
        @ChildContent
    </div>
    @if (_error is not null)
    {
        <p class="form-error" role="alert">@_error</p>
    }
    <div class="form-actions">
        @Actions
        <Button Submit Busy="_busy">@(Submit ?? EnfiladeText.Save)</Button>
    </div>
</EditForm>
<NavigationLock OnBeforeInternalNavigation="LeavingAsync" ConfirmExternalNavigation="_confirmsLeaving" />

@code {
    private static readonly JsonSerializerOptions SnapshotOptions = new()
    {
        IncludeFields = true,
        ReferenceHandler = ReferenceHandler.IgnoreCycles,
    };

    private EditContext _edit = default!;
    private ValidationMessageStore _server = default!;
    private byte[] _saved = [];
    private string? _error;
    private bool _busy;
    private bool _confirmsLeaving;

    [CascadingParameter]
    private SheetGuard? Guard { get; set; }

    [CascadingParameter]
    private IMudDialogInstance? Dialog { get; set; }

    [Parameter, EditorRequired]
    public object Model { get; set; } = default!;

    [Parameter]
    public EventCallback OnSubmit { get; set; }

    [Parameter]
    public string? Submit { get; set; }

    [Parameter]
    public string? Done { get; set; }

    [Parameter]
    public bool Refresh { get; set; } = true;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    public bool IsDirty => !Snapshot().AsSpan().SequenceEqual(_saved);

    protected override void OnInitialized() => Guard?.Watch(this);

    protected override void OnParametersSet()
    {
        if (_edit?.Model != Model)
        {
            if (_edit is not null)
                _edit.OnFieldChanged -= FieldChanged;
            _edit = new EditContext(Model);
            _server = new ValidationMessageStore(_edit);
            _edit.OnFieldChanged += FieldChanged;
            _saved = Snapshot();
        }

        _confirmsLeaving = IsDirty;
    }

    public void Dispose()
    {
        _edit.OnFieldChanged -= FieldChanged;
        Guard?.Forget(this);
    }

    private byte[] Snapshot() => JsonSerializer.SerializeToUtf8Bytes(Model, Model.GetType(), SnapshotOptions);

    private void FieldChanged(object? sender, FieldChangedEventArgs args)
    {
        _server.Clear(args.FieldIdentifier);
        var dirty = IsDirty;
        if (dirty == _confirmsLeaving)
            return;

        _confirmsLeaving = dirty;
        StateHasChanged();
    }

    private async Task SubmitAsync()
    {
        if (_busy)
            return;

        _busy = true;
        _error = null;
        try
        {
            if (!await SaveAsync())
                return;

            _saved = Snapshot();
            _confirmsLeaving = false;
            Snackbar.Add(Done ?? EnfiladeText.Saved, Severity.Normal);
            if (Refresh)
                await CurrentPage.RefreshAsync();
            Dialog?.Close(DialogResult.Ok(Model));
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<bool> SaveAsync()
    {
        try
        {
            await OnSubmit.InvokeAsync();
            return true;
        }
        catch (FieldException exception)
        {
            foreach (var (field, message) in exception.Errors)
                _server.Add(_edit.Field(field), message);
            _edit.NotifyValidationStateChanged();
        }
        catch (Exception exception) when (ErrorMessages.Cancelled(exception))
        {
        }
        catch (Exception exception)
        {
            _error = Errors.Describe(exception, Logger, EnfiladeText.Failed);
        }

        return false;
    }

    private async Task LeavingAsync(LocationChangingContext leaving)
    {
        if (IsDirty && !await Dialogs.ConfirmAsync(EnfiladeText.DiscardQuestion, EnfiladeText.DiscardMessage, EnfiladeText.Discard, danger: true))
            leaving.PreventNavigation();
    }
}
