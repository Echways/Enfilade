@namespace Enfilade
@typeparam TItem
@implements IDisposable

@code {
    private CellDefinition<TItem>? _definition;

    [CascadingParameter]
    private ListingContext<TItem> Context { get; set; } = default!;

    [Parameter]
    public string Title { get; set; } = "";

    [Parameter, EditorRequired]
    public RenderFragment<TItem> ChildContent { get; set; } = default!;

    protected override void OnParametersSet() => _definition = Context.Cells.Place(_definition, new CellDefinition<TItem>(Title, null, null, false, ChildContent));

    public void Dispose() => Context.Cells.Remove(_definition);
}
