@namespace Enfilade

@if (!_dismissed)
{
    <div class="banner">
        <Notice Tone="Tone" Title="@Title" ChildContent="ChildContent" Actions="@(Actions is null && !Dismissible ? null : Controls)" />
    </div>
}

@code {
    private bool _dismissed;

    [Parameter]
    public Tone Tone { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public bool Dismissible { get; set; }

    [Parameter]
    public EventCallback OnDismiss { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    private RenderFragment Controls => @<text>
        @Actions
        @if (Dismissible)
        {
            <button type="button" class="link" aria-label="@EnfiladeText.Close" title="@EnfiladeText.Close" @onclick="DismissAsync">×</button>
        }
    </text>;

    private async Task DismissAsync()
    {
        _dismissed = true;
        await OnDismiss.InvokeAsync();
    }
}
