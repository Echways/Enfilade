@namespace Enfilade
<MudDialog Class="confirm" TitleClass="confirm-head" ContentClass="confirm-body" ActionsClass="confirm-foot">
    <TitleContent>
        <h2>@Dialog.Title</h2>
    </TitleContent>
    <DialogContent>
        <p>@Message</p>
    </DialogContent>
    <DialogActions>
        <button type="button" class="link" @onclick="Dialog.Cancel">@EnfiladeText.Cancel</button>
        <button type="button" class="@(Danger ? "btn-danger" : "btn-k pigment")" @onclick="() => Dialog.Close(DialogResult.Ok(true))">@Yes</button>
    </DialogActions>
</MudDialog>

@code {
    internal static readonly DialogOptions Centered = new()
    {
        Position = DialogPosition.Center,
        MaxWidth = MaxWidth.False,
        CloseOnEscapeKey = true,
        CloseButton = false,
        DefaultFocus = DefaultFocus.FirstChild,
    };

    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter]
    public string Message { get; set; } = "";

    [Parameter]
    public string Yes { get; set; } = "";

    [Parameter]
    public bool Danger { get; set; }
}
