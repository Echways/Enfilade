@namespace Enfilade

<div class="empty">
    <h2>@Title</h2>
    @if (Hint is not null)
    {
        <p class="empty-hint">@Hint</p>
    }
    @ChildContent
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter]
    public string? Hint { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
