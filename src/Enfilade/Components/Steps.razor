@namespace Enfilade

<ol class="steps">
    @foreach (var step in Items)
    {
        <li class="step @step.State.ToString().ToLowerInvariant()" aria-current="@(step.State == StepState.Current ? "step" : null)">
            <span class="step-mark" aria-hidden="true"></span>
            <span class="step-text">
                <span class="step-title">@step.Title</span>
                @if (step.Detail is not null)
                {
                    <span class="step-detail">@step.Detail</span>
                }
            </span>
            @if (StateText(step.State) is { } text)
            {
                <span class="sr">@text</span>
            }
        </li>
    }
</ol>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<Step> Items { get; set; } = [];

    private static string? StateText(StepState state) => state switch
    {
        StepState.Done => EnfiladeText.StepDone,
        StepState.Failed => EnfiladeText.StepFailed,
        StepState.Current => EnfiladeText.StepCurrent,
        _ => null,
    };
}
