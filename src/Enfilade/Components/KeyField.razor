@namespace Enfilade
<div class="kf pigment @(Born ? "born" : "")">
    <label class="kf-label" for="@_id">@Label</label>
    <output id="@_id" class="kf-token">@for (var index = 0; index < _groups.Count; index++){var order = index;<span class="g" style="--i: @order">@_groups[order]</span>}</output>
    <CopyButton Value="@Value" Label="@CopyLabel" Class="kf-copy" />
</div>

@code {
    private const int GroupLength = 4;

    private readonly string _id = "key-" + Guid.NewGuid().ToString("N")[..8];

    private List<string> _groups = [];

    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter, EditorRequired]
    public string Value { get; set; } = "";

    [Parameter, EditorRequired]
    public string CopyLabel { get; set; } = "";

    [Parameter]
    public bool Born { get; set; }

    protected override void OnParametersSet()
    {
        var prefix = Value.IndexOf('_') + 1;
        _groups = [Value[..prefix], .. Value[prefix..].Chunk(GroupLength).Select(group => new string(group))];
    }
}
