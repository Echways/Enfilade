@namespace Enfilade
<span class="crumb on">
    <span class="crumb-kind">@Kind</span>@(" ")
    @if (Code)
    {
        <code>@Value</code>
    }
    else
    {
        <b>@Value</b>
    }
    <a class="crumb-off" href="@Without" aria-label="@string.Format(EnfiladeText.RemoveFilter, Kind, Value)" title="@EnfiladeText.RemoveFilterHint">×</a>
</span>

@code {
    [Parameter, EditorRequired]
    public string Kind { get; set; } = "";

    [Parameter, EditorRequired]
    public string Value { get; set; } = "";

    [Parameter, EditorRequired]
    public string Without { get; set; } = "";

    [Parameter]
    public bool Code { get; set; }
}
