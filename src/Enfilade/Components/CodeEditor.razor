@namespace Enfilade
@implements IAsyncDisposable
@inject IJSRuntime Js
@inject NavigationManager Navigation

<div @ref="_host" class="code-editor"></div>

@code {
    private ElementReference _host;
    private IJSObjectReference? _module;
    private DotNetObjectReference<CodeEditor>? _self;
    private bool _readOnly;

    [Parameter]
    public string Value { get; set; } = "";

    [Parameter]
    public string? Language { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public EventCallback OnChange { get; set; }

    public async ValueTask<string> GetValueAsync() =>
        _module is null ? Value : await _module.InvokeAsync<string>("getValue", _host);

    public async ValueTask SetValueAsync(string value)
    {
        Value = value;
        if (_module is not null)
            await _module.InvokeVoidAsync("setValue", _host, value);
    }

    [JSInvokable]
    public Task EditorChanged() => InvokeAsync(OnChange.InvokeAsync);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _readOnly = ReadOnly;
            _module = await Js.InvokeAsync<IJSObjectReference>("import", Navigation.ToAbsoluteUri(Assets["_content/Enfilade/editor.js"]).AbsoluteUri);
            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("create", _host, _self, Value, ReadOnly, Language);
        }
        else if (_module is not null && _readOnly != ReadOnly)
        {
            _readOnly = ReadOnly;
            await _module.InvokeVoidAsync("setReadOnly", _host, ReadOnly);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _self?.Dispose();
        if (_module is null)
            return;

        try
        {
            await _module.InvokeVoidAsync("dispose", _host);
            await _module.DisposeAsync();
        }
        catch (Exception failure) when (failure is JSDisconnectedException or ObjectDisposedException or InvalidOperationException)
        {
        }
    }
}
