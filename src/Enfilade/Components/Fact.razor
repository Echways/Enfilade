@namespace Enfilade

<div class="fact">
    <dt>@Label</dt>
    <dd>@(ChildContent ?? (RenderFragment)(builder => builder.AddContent(0, Words.Of(Value))))</dd>
</div>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public object? Value { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
