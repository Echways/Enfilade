@namespace Enfilade
@using MudBlazor.Services
@implements IAsyncDisposable
@inject IDialogService Dialogs
@inject IKeyInterceptorService Keys

<MudDialog Class="sheet" TitleClass="sheet-head" ContentClass="sheet-body" ActionsClass="sheet-foot">
    <TitleContent>
        <h2>@Dialog.Title</h2>
        <button type="button" class="link" @onclick="CloseAsync">@EnfiladeText.Close</button>
    </TitleContent>
    <DialogContent>
        <CascadingValue Value="_guard" IsFixed="true">
            @ChildContent
        </CascadingValue>
    </DialogContent>
    <DialogActions>
        <CascadingValue Value="_guard" IsFixed="true">
            @Actions
        </CascadingValue>
    </DialogActions>
</MudDialog>

@code {
    internal static readonly DialogOptions Form = new()
    {
        Position = DialogPosition.CenterRight,
        MaxWidth = MaxWidth.False,
        BackdropClick = false,
        CloseOnEscapeKey = false,
        CloseButton = false,
        DefaultFocus = DefaultFocus.FirstChild,
    };

    internal static readonly DialogOptions View = new()
    {
        Position = DialogPosition.CenterRight,
        MaxWidth = MaxWidth.False,
        BackdropClick = true,
        CloseOnEscapeKey = true,
        CloseButton = false,
        DefaultFocus = DefaultFocus.FirstChild,
    };

    private readonly SheetGuard _guard = new();

    private string? _escapeTarget;

    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Dialog.Options.CloseOnEscapeKey == true)
            return;

        _escapeTarget = $"_{Dialog.Id:N}";
        await Keys.SubscribeAsync(_escapeTarget, new KeyInterceptorOptions(new KeyOptions("Escape", subscribeDown: true)), keys => keys.OnKeyDown("Escape", CloseAsync));
    }

    public async ValueTask DisposeAsync()
    {
        if (_escapeTarget is not null)
            await Keys.UnsubscribeAsync(_escapeTarget);
    }

    private async Task CloseAsync()
    {
        if (_guard.Dirty && !await Dialogs.ConfirmAsync(EnfiladeText.DiscardQuestion, EnfiladeText.DiscardMessage, EnfiladeText.Discard, danger: true))
            return;

        _guard.Dirty = false;
        Dialog.Cancel();
    }
}
