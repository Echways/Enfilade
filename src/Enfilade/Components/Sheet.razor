@namespace Enfilade
@inject IDialogService Dialogs

<MudDialog Class="sheet" TitleClass="sheet-head" ContentClass="sheet-body" ActionsClass="sheet-foot" OnKeyDown="KeyDownAsync">
    <TitleContent>
        <h2>@Dialog.Title</h2>
        <button type="button" class="link" @onclick="CloseAsync">@EnfiladeText.Close</button>
    </TitleContent>
    <DialogContent>
        <CascadingValue Value="_guard" IsFixed="true">
            @ChildContent
        </CascadingValue>
    </DialogContent>
    <DialogActions>
        <CascadingValue Value="_guard" IsFixed="true">
            @Actions
        </CascadingValue>
    </DialogActions>
</MudDialog>

@code {
    internal static readonly DialogOptions Form = new()
    {
        Position = DialogPosition.CenterRight,
        MaxWidth = MaxWidth.False,
        BackdropClick = false,
        CloseOnEscapeKey = false,
        CloseButton = false,
        DefaultFocus = DefaultFocus.FirstChild,
    };

    internal static readonly DialogOptions View = new()
    {
        Position = DialogPosition.CenterRight,
        MaxWidth = MaxWidth.False,
        BackdropClick = true,
        CloseOnEscapeKey = true,
        CloseButton = false,
        DefaultFocus = DefaultFocus.FirstChild,
    };

    private readonly SheetGuard _guard = new();

    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    private async Task CloseAsync()
    {
        if (_guard.Dirty && !await Dialogs.ConfirmAsync(EnfiladeText.DiscardQuestion, EnfiladeText.DiscardMessage, EnfiladeText.Discard, danger: true))
            return;

        _guard.Dirty = false;
        Dialog.Cancel();
    }

    private Task KeyDownAsync(KeyboardEventArgs key) =>
        key.Key == "Escape" && Dialog.Options.CloseOnEscapeKey != true ? CloseAsync() : Task.CompletedTask;
}
