@namespace Enfilade
<figure class="fig @(Alarm ? "alarm" : "")" aria-labelledby="@Labels">
    <b id="@_id-value" class="@(Text is null ? "" : "word")" style="--chars: @Written.Count(char.IsLetterOrDigit)">@Written</b>
    @if (Change is { } change)
    {
        <span id="@_id-change" class="change @ToneOf(change).ToString().ToLowerInvariant()">
            <span aria-hidden="true">@Shown(change)</span>
            <span class="sr">@Words.Format(EnfiladeText.ChangeToPrevious, Shown(change))</span>
        </span>
    }
    @if (Spark is not null)
    {
        <Sparkline Values="Spark" Tone="@(Change is { } trend ? ToneOf(trend) : Tone.Neutral)" />
    }
    <figcaption id="@_id-note">
        <span>@First</span>
        <span>@Second</span>
    </figcaption>
</figure>

@code {
    private readonly string _id = ElementId.New("figure");

    [Parameter]
    public long Value { get; set; }

    [Parameter]
    public string? Text { get; set; }

    [Parameter, EditorRequired]
    public string First { get; set; } = "";

    [Parameter, EditorRequired]
    public string Second { get; set; } = "";

    [Parameter]
    public bool Alarm { get; set; }

    [Parameter]
    public double? Change { get; set; }

    [Parameter]
    public bool LowerIsBetter { get; set; }

    [Parameter]
    public IReadOnlyList<double>? Spark { get; set; }

    private string Written => Text ?? Words.Number(Value);

    private string Labels => Change is null ? $"{_id}-value {_id}-note" : $"{_id}-value {_id}-change {_id}-note";

    private static string Shown(double change) => change switch
    {
        > 0 => "+" + Words.Share(change),
        < 0 => "−" + Words.Share(-change),
        _ => Words.Share(0),
    };

    private Tone ToneOf(double change) => (LowerIsBetter ? -Math.Sign(change) : Math.Sign(change)) switch
    {
        > 0 => Tone.Good,
        < 0 => Tone.Bad,
        _ => Tone.Neutral,
    };
}
