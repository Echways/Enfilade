@namespace Enfilade
@inject Act Act

<button @attributes="Attributes" type="@(Submit ? "submit" : "button")" class="@Classes" disabled="@(Disabled || Working)"
        aria-busy="@(Working ? "true" : null)" @onclick="ClickAsync">
    @ChildContent
    @if (Working)
    {
        <span class="sr">@EnfiladeText.Working</span>
    }
</button>

@code {
    private bool _running;

    [Parameter]
    public ButtonKind Kind { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter]
    public Confirm? Confirm { get; set; }

    [Parameter]
    public string? Done { get; set; }

    [Parameter]
    public bool Refresh { get; set; } = true;

    [Parameter]
    public bool Submit { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private bool Working => _running || Busy;

    private string Classes => string.Join(" ", new[]
    {
        Kind switch
        {
            ButtonKind.Danger => "btn-danger",
            ButtonKind.Quiet => "link",
            _ => "btn-k pigment",
        },
        Working ? "busy" : null,
        Attributes?.GetValueOrDefault("class") as string,
    }.OfType<string>());

    private async Task ClickAsync()
    {
        if (Submit || _running)
            return;

        _running = true;
        try
        {
            await Act.RunAsync(() => OnClick.InvokeAsync(), Done, Confirm, Refresh);
        }
        finally
        {
            _running = false;
        }
    }
}
