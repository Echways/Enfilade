@inject IOptions<EnfiladeOptions> Options

<Router AppAssembly="typeof(Routes).Assembly" AdditionalAssemblies="Options.Value.AdditionalAssemblies" NotFoundPage="typeof(NotFound)">
    <Found Context="route">
        <FocusOnNavigate RouteData="route" Selector="h1" />
        <CascadingValue Value="Options.Value.SectionOf(route.PageType)">
            @if (Options.Value.Guards(route.PageType))
            {
                <AuthorizeView>
                    <Authorized>
                        @Page(route)
                    </Authorized>
                    <NotAuthorized>
                        <ToLogin />
                    </NotAuthorized>
                </AuthorizeView>
            }
            else
            {
                @Page(route)
            }
        </CascadingValue>
    </Found>
</Router>

@code {
    private RenderFragment Page(RouteData route) =>
        @<AuthorizeRouteView RouteData="route" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized Context="authentication">
                @if (authentication.User.Identity?.IsAuthenticated == true || Options.Value.LoginPath is null)
                {
                    <Forbidden />
                }
                else
                {
                    <ToLogin />
                }
            </NotAuthorized>
        </AuthorizeRouteView>;
}
