@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject IOptions<EnfiladeOptions> Options
@inject ViewerZone ViewerZone

<MudThemeProvider @ref="_themes" Theme="_theme" IsDarkMode="_dark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="frame">
    <header class="side">
        <span class="brand">@Options.Value.Brand</span>
        <Navigation />
        <AuthorizeView Context="auth">
            <Authorized>
                @Account(auth.User.Identity?.Name)
            </Authorized>
            <NotAuthorized>
                @Account(null)
            </NotAuthorized>
        </AuthorizeView>
    </header>
    <main class="main">
        @if (ViewerZone.Known)
        {
            <ErrorBoundary @ref="_failure">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <div class="empty failure" role="alert">
                        <h1>@EnfiladeText.FailureHeading</h1>
                        <p class="note">@EnfiladeText.FailureHint</p>
                        <button type="button" class="btn-k pigment" @onclick="_failure!.Recover">@EnfiladeText.TryAgain</button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        }
        else
        {
            <Placeholder />
        }
    </main>
</div>

@code {
    private ErrorBoundary? _failure;
    private MudThemeProvider? _themes;
    private MudTheme _theme = default!;
    private bool _dark = true;

    private System.Globalization.CultureInfo? Language => LanguageChoice.Next(Options.Value);

    protected override void OnInitialized()
    {
        Words.Zone = ViewerZone.Zone;
        _theme = EnfiladeTheme.For(Options.Value.Accent);
        _dark = Options.Value.Appearance != Appearance.Light;
    }

    protected override void OnParametersSet() => _failure?.Recover();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        if (Options.Value.Appearance == Appearance.System && _themes is not null)
        {
            _dark = await _themes.GetSystemDarkModeAsync();
            await _themes.WatchSystemDarkModeAsync(DarkModeChangedAsync);
            StateHasChanged();
        }

        if (!ViewerZone.Known)
        {
            ViewerZone.Settle(await BrowserZoneAsync());
            Words.Zone = ViewerZone.Zone;
            StateHasChanged();
        }
    }

    private Task DarkModeChangedAsync(bool dark)
    {
        _dark = dark;
        return InvokeAsync(StateHasChanged);
    }

    private async Task<string?> BrowserZoneAsync()
    {
        try
        {
            return await Js.InvokeAsync<string?>("enfilade.zone");
        }
        catch (JSException)
        {
            return null;
        }
    }

    private void SwitchLanguage() => Navigation.NavigateTo(LanguageChoice.Path(Navigation, Language!), forceLoad: true);

    private void SignOut() => Navigation.NavigateTo(Options.Value.SignOutPath!, forceLoad: true);

    private RenderFragment Account(string? name) => @<text>
        @if (name is not null || Language is not null || Options.Value.AccountLinks.Count > 0)
        {
            var leaving = name is not null && Options.Value.SignOutPath is not null;
            <div class="account">
                @if (name is not null)
                {
                    <span>@name</span>
                }
                @foreach (var link in Options.Value.AccountLinks)
                {
                    <a href="@link.Href">@link.Title()</a>
                }
                @if (Language is { } language)
                {
                    <button type="button" lang="@language.Name" @onclick="SwitchLanguage">@LanguageChoice.Title(language)</button>
                }
                @if (leaving)
                {
                    <button type="button" @onclick="SignOut">@EnfiladeText.SignOut</button>
                }
            </div>
            <MudMenu Class="account-menu" Label="@(name ?? (Language is { } shown ? LanguageChoice.Title(shown) : EnfiladeText.Account))" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                @foreach (var link in Options.Value.AccountLinks)
                {
                    <MudMenuItem Href="@link.Href">@link.Title()</MudMenuItem>
                }
                @if (Language is { } language)
                {
                    <MudMenuItem OnClick="SwitchLanguage">
                        <span lang="@language.Name">@LanguageChoice.Title(language)</span>
                    </MudMenuItem>
                }
                @if (leaving)
                {
                    <MudMenuItem OnClick="SignOut">@EnfiladeText.SignOut</MudMenuItem>
                }
            </MudMenu>
        }
    </text>;
}
