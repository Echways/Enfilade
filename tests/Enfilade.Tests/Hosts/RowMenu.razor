<div class="row" @onclick="() => Opened++">
    <Menu>
        <MenuItem OnClick="OnClick" Done="@Done" Danger="Danger">Удалить</MenuItem>
    </Menu>
</div>

@code {
    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter]
    public string? Done { get; set; }

    [Parameter]
    public bool Danger { get; set; }

    public int Opened { get; private set; }
}
