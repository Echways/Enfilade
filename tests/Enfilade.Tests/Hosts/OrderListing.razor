<Listing TItem="Order" @ref="Listing" Load="Load" Items="Items" Sort="@Sort" Href="Href" OnOpen="OnOpen" Empty="Empty" Name="@Name">
    <Columns>
        <Cell Title="Клиент" Value="order => order.Customer" Sort />
        <Cell Title="Сумма" Value="order => order.Total" Sort />
        <Cell Title="Статус" Value="order => order.Status" />
    </Columns>
</Listing>

@code {
    public Listing<Order> Listing { get; private set; } = default!;

    [Parameter]
    public Func<ListQuery<Order>, CancellationToken, Task<ListPage<Order>>>? Load { get; set; }

    [Parameter]
    public IReadOnlyCollection<Order>? Items { get; set; }

    [Parameter]
    public string? Sort { get; set; }

    [Parameter]
    public Func<Order, string>? Href { get; set; }

    [Parameter]
    public EventCallback<Order> OnOpen { get; set; }

    [Parameter]
    public RenderFragment? Empty { get; set; }

    [Parameter]
    public string? Name { get; set; }
}
